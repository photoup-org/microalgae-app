# Copy to .env.local and fill in. .env.local is gitignored.
# DATABASE_URL must live in .env (not .env.local) so the Prisma CLI picks it up.

# --- Postgres (shared with app-gui; this app NEVER migrates it) ---
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# --- Auth0 -------------------------------------------------------------------
# The Auth0 application must list APP_BASE_URL + /auth/callback in its Allowed
# Callback URLs, and APP_BASE_URL in its Allowed Logout URLs, or login fails.
# No Organizations are used here; sign-up is invite-only, controlled in Auth0.
#
# This app runs on port 3000, the same port app-gui uses. Run only one of them at
# a time. 3000 is also where the edge worker sends the device-online webhook by
# default, so keeping this port means docker-compose needs no change.
AUTH0_DOMAIN="your-tenant.eu.auth0.com"
AUTH0_CLIENT_ID=""
AUTH0_CLIENT_SECRET=""
# openssl rand -hex 32
AUTH0_SECRET=""
APP_BASE_URL="http://localhost:3000"

# --- Tenancy -----------------------------------------------------------------
# Must be an existing Department.id. Department is not modelled in this app's
# schema, but Postgres still enforces the foreign key on User/Project/Device.
# Keep in sync with the edge worker's DEPARTMENT_ID env, which is what determines
# the ui/live/department/{id}/... topics the browser subscribes to.
DEPARTMENT_ID="71cc83b5-cba4-430f-be33-8200dbb8c90f"
NEXT_PUBLIC_DEPARTMENT_ID="71cc83b5-cba4-430f-be33-8200dbb8c90f"

# SKU of the HardwareProduct to attach new reactor devices to. Device.productId is
# NOT NULL with a foreign key and this app never creates products, so this must
# resolve to an existing row.
REACTOR_PRODUCT_SKU=""

# --- InfluxDB (read-only; the edge worker writes) ----------------------------
INFLUX_URL=""
INFLUX_TOKEN=""
INFLUX_ORG="haas"
INFLUX_BUCKET="telemetry"

# --- MQTT --------------------------------------------------------------------
# Server-side TCP, used by Server Actions to publish commands.
MQTT_CONNECTION_URL=""
# Browser-side WebSocket, used by the live telemetry store.
NEXT_PUBLIC_MQTT_CONNECTION_URL=""

# Shared with the edge worker's EDGE_WEBHOOK_SECRET. The worker will not release
# any telemetry until POST /api/webhooks/device-online returns 200.
EDGE_WEBHOOK_SECRET=""

# --- Web push (VAPID) --------------------------------------------------
# Generate a pair with: node -e "console.log(require('web-push').generateVAPIDKeys())"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- Local (LAN) session ------------------------------------------------
# ONLY for the instance running on the Pi. It lets a device that paired while
# online stay signed in with the internet down, which Auth0 cannot do. Leaving
# this enabled on an internet-facing instance would expose an offline credential.
# Generate the secret with: openssl rand -hex 32
LOCAL_SESSION_ENABLED=false
LOCAL_SESSION_SECRET=
LOCAL_SESSION_TTL_DAYS=30

# --- Read-only cloud mirror ---------------------------------------------
# A copy of the Pi's database, so the cloud console still answers when the Pi is
# unreachable. Set on the CLOUD instance only - the LAN instance is the primary,
# and a mirror there would be a copy of itself. Unset disables the feature.
# Refresh it by POSTing to /api/mirror/sync with the EDGE_WEBHOOK_SECRET bearer.
MIRROR_DATABASE_URL=

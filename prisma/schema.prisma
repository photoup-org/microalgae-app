// Slim READ-ONLY mirror of app-gui/prisma/schema.prisma.
// See prisma/README.md before touching this file. Never run `prisma migrate` here.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  OPERATOR
  SUPER_ADMIN
  VIEWER
}

enum DeviceStatus {
  UNCLAIMED
  ACTIVE
  MAINTENANCE
  PENDING_CONNECTION
  DISABLED
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
}

enum ExperimentStatus {
  PLANNED
  RUNNING
  COMPLETED
  PAUSED
}

enum HardwareType {
  GATEWAY
  SENSOR_BASE
  SENSOR_PREMIUM
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  image        String?
  auth0UserId  String?  @unique
  role         Role     @default(VIEWER)
  jobTitle     String?
  phone        String?
  // Department is not modelled here; Postgres still enforces the foreign key.
  departmentId String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  createdProjects Project[]           @relation("ProjectCreator")
  calibrations    CalibrationRecord[]
}

/// A Reactor. The UI never says "Project".
model Project {
  id           String        @id @default(cuid())
  name         String
  description  String?
  departmentId String
  createdById  String
  status       ProjectStatus @default(ACTIVE)
  settings     Json?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  createdBy   User         @relation("ProjectCreator", fields: [createdById], references: [id])
  experiments Experiment[]
  /// Many-to-many: a reactor can be shared by several projects. Exclusivity is
  /// enforced per RUN, not per project - see createExperimentAction.
  devices     Device[]     @relation("DeviceProjects")
}

/// One perpetual RUNNING experiment per reactor. Never surfaced in the UI, but
/// required: the edge worker only flushes telemetry to InfluxDB while one is open.
model Experiment {
  id                 String           @id @default(cuid())
  name               String
  projectId          String
  status             ExperimentStatus @default(RUNNING)
  startDate          DateTime         @default(now())
  endDate            DateTime?
  settings           Json?
  accumulatedSeconds Int              @default(0)
  lastRunAt          DateTime?

  project Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  devices Device[]
}

model Device {
  id           String       @id @default(cuid())
  name         String?
  /// Must equal the ESP32's on-wire device_id. See prisma/README.md.
  serialNumber String       @unique
  status       DeviceStatus @default(ACTIVE)
  productId    String
  departmentId String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  /// Control state for this reactor: { valveOpen, targetPh, phTolerance }.
  config       Json?        @default("{}")

  calibrationConfig  Json?
  lastCalibrated     DateTime?
  calibrationDueDate DateTime?

  /// Firmware version this node last reported on nodes/{id}/metadata, and when.
  ///
  /// The timestamp is not decoration: the metadata topic is retained, so a node
  /// that has been unplugged for a month still has a version on file. Showing it
  /// without saying how old it is would present a guess as a fact - and the OTA
  /// rollout decides who is outdated from exactly this value.
  firmwareVersion    String?
  firmwareReportedAt DateTime?

  product      HardwareProduct     @relation(fields: [productId], references: [id])
  projects     Project[]           @relation("DeviceProjects")
  experiments  Experiment[]
  calibrations CalibrationRecord[]
}

/// Read-only. Device.productId is NOT NULL with a foreign key, so provisioning
/// has to resolve a real product row; this app never creates one.
model HardwareProduct {
  id   String       @id @default(cuid())
  sku  String       @unique
  name String
  type HardwareType

  devices Device[]
}

enum LogLevel {
  INFO
  WARN
  ERROR
  CRITICAL
}

enum LogCategory {
  EXPERIMENT
  ALERT
  HARDWARE
  SYSTEM
}

/// Written by the edge worker via this app's own app/api/system-logs (threshold
/// breaches from device_buffer.py, hardware online/offline transitions from
/// device_tracker.py) - and separately by app-gui, which writes experiment
/// lifecycle events into the same shared table via its own /api/system-logs.
/// Plain scalar links (no relation()), matching this file's convention for
/// loosely-coupled ids - see prisma/README.md.
model SystemLog {
  id        String   @id @default(uuid())
  timestamp DateTime @default(now())

  level    LogLevel
  category LogCategory
  action   String
  message  String
  metadata Json?

  departmentId String
  projectId    String?
  experimentId String?
  deviceId     String?

  /// Incident lifecycle, added in app-gui migration
  /// 20260824100000_system_log_incident_lifecycle.
  ///
  /// A log row is either history (INFO) or a *condition* someone has to look at
  /// (WARN and above). Only the second kind carries a dedupKey: the edge re-raises
  /// the same threshold breach every 60s, so a week-long excursion would otherwise
  /// be ~10k identical rows. Ingest folds a repeat into the newest row with the
  /// same key that nobody has acknowledged yet, bumping occurrences and lastSeenAt.
  /// Acknowledging closes that row, so the next occurrence opens a fresh one.
  ///
  /// `timestamp` therefore means FIRST seen once a row has been folded into;
  /// lastSeenAt is null until the second occurrence arrives.
  dedupKey       String?
  occurrences    Int       @default(1)
  lastSeenAt     DateTime?
  acknowledgedAt DateTime?
  /// A display name, not a User id - matches CalibrationRecord.performedBy.
  acknowledgedBy String?

  @@index([departmentId, timestamp(sort: Desc)])
  @@index([departmentId, dedupKey, acknowledgedAt])
}

/// A browser push endpoint, one row per device someone has opted in on.
///
/// Mirrored from app-gui migration 20260824120000_push_subscription, but this app
/// is the only one that reads or writes it - app-gui has no push feature. No
/// relation() to Department or User there either, so there is nothing to mirror
/// here beyond the scalars.
///
/// Rows are disposable: a 404 or 410 from the push service means the browser threw
/// the subscription away, and lib/services/push.ts deletes the row when it sees one.
/// Single row, written only in the read-only cloud mirror.
///
/// The mirror is a copy of the Pi's database that the cloud instance falls back to
/// when the Pi is unreachable. Without a recorded sync time the fallback would
/// present stale rows as if they were current, which is worse than showing
/// nothing - so the banner reads this and states how old the data is.
///
/// Exists in the primary schema too because both databases are created from this
/// one file; in the primary it simply stays empty.
model MirrorSync {
  /// Always "singleton". A table with one row needs a fixed key, not a cuid.
  id           String   @id
  syncedAt     DateTime
  /// Row counts per table at sync time, for spotting a truncated copy.
  rowCounts    Json?
}

/// A write that was made on the LAN instance while the cloud was unreachable.
///
/// Lives ONLY in the Pi's local replica - the authoritative Neon database never
/// has rows here, even though the table exists in both (one schema builds both).
///
/// Replay is safe because the cloud cannot move a reactor's state while the Pi is
/// away: updateExperimentLifecycleAction and setValveAction both publish to the
/// edge first and refuse if it does not answer. So a queued entry has nothing to
/// race against. Pure metadata edits (renaming a project) are the exception and
/// resolve last-write-wins.
///
/// Entries are applied to the replica immediately so the UI reflects them, then
/// drained to the cloud on reconnect. A replica refresh MUST NOT run while any
/// entry is pending - refreshMirror is a full delete-and-insert and would discard
/// the local rows the entry represents.
model OutboxEntry {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  /// Names the server action to replay, e.g. "experiment.lifecycle".
  action    String
  /// Arguments for that action, as sent originally.
  payload   Json
  /// Set once the cloud has accepted it. Kept, not deleted, so a drain that fails
  /// halfway cannot double-apply the entries it already pushed.
  appliedAt DateTime?
  /// Last replay failure, for the operator. A stuck entry must be visible.
  lastError String?

  @@index([appliedAt, createdAt])
}

model PushSubscription {
  id           String    @id @default(cuid())
  departmentId String
  userId       String?
  /// Unique, so re-subscribing the same browser updates its row instead of
  /// accumulating duplicates that would all fire at once.
  endpoint     String    @unique
  p256dh       String
  auth         String
  userAgent    String?
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  @@index([departmentId])
}

model CalibrationRecord {
  id            String    @id @default(cuid())
  deviceId      String
  userId        String?
  timestamp     DateTime  @default(now())
  calibratedAt  DateTime  @default(now())
  validUntil    DateTime?
  performedBy   String
  notes         String?
  pointsApplied Json?
  oldConfig     Json?
  newConfig     Json?
  /// Which sensor channel this calibration applied to ("ph", "turbidity", ...).
  /// Null only for rows written before the column existed.
  metric        String?

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([deviceId, calibratedAt(sort: Desc)])
}
